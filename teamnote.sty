\setlength{\columnseprule}{0.2pt}
\pagenumbering{arabic}
\definecolor{mygreen}{rgb}{0,0.6,0}
\definecolor{mygray}{rgb}{0.5,0.5,0.5}
\definecolor{mymauve}{rgb}{0.58,0,0.82}

\lstset{
basicstyle=\fontsize{6}{7}\ttfamily,
columns=fullflexible,
breaklines=true,
keepspaces=true,
showstringspaces=false,
tabsize=2,
commentstyle=\color{mygreen},
keywordstyle=\color{blue},
stringstyle=\color{mymauve},
numberstyle=\tiny\color{mygray},
numbers=left,
numbersep=3pt,
xleftmargin=11pt,
framexleftmargin=0pt
}
\lstdefinelanguage{cpp}[]{C++}{}
\newcommand{\inputminted}[3][]{%
\ifthenelse{\equal{#2}{compactcpp}}%
{\lstinputlisting[language=cpp,linerange={NOTEBOOK_BEGIN-NOTEBOOK_END},rangeprefix={//},includerangemarker=false,gobble=2,firstnumber=0,#1]{#3}}%
{\lstinputlisting[language=#2,#1]{#3}}}


\newcommand{\revised}{Cần \textcolor{red}{\textbf{rà soát}}.}
\newcommand{\tested}{Cần \textcolor{red}{\textbf{kiểm tra}}.}
\newcommand{\added}{Cần \textcolor{red}{\textbf{bổ sung}}.}
\newcommand{\WIP}{\textcolor{red}{\textbf{Đang hoàn thiện.}}}

\newcommand{\schoolname}{Trường Đại học Công nghệ Thông tin, ĐHQG-HCM}
\newcommand{\teamname}{UIT.BTC}
\newcommand{\authorname}{Vu Gia Bao, Nguyen Khanh Tai, Huynh Trung Cuong}

\newcommand{\maketitlepage}{
	
\tableofcontents

\thispagestyle{fancy}

}
\DeclareRobustCommand{\teamnote}[3]{
	\renewcommand{\schoolname}{#1}
    \renewcommand{\teamname}{#2}
    \renewcommand{\authorname}{#3}
}
\pagestyle{fancy}
\lhead{\schoolname{} -- \teamname}
\rhead{Trang \thepage{} / 
\ifthenelse{\getpagerefnumber{LastPage} < 26}{\pageref{LastPage}}{\textcolor{red}{\textbf{\pageref{LastPage}}}}}
\fancyfoot{}

\title{Notebook của đội \teamname}
\author{\authorname}
\date{Biên dịch ngày \today}

\newboolean{BangShowUsage}
\setboolean{BangShowUsage}{false} 
\newcommand{\ShowUsage}{\setboolean{BangShowUsage}{false}}
\newcommand{\HideUsage}{\setboolean{BangShowUsage}{true}}

\newboolean{BangShowComplexity}
\setboolean{BangShowComplexity}{false} 
\newcommand{\ShowComplexity}{\setboolean{BangShowComplexity}{false}}
\newcommand{\HideComplexity}{\setboolean{BangShowComplexity}{true}}


\newboolean{BangShowAuthor}
\setboolean{BangShowAuthor}{false} 
\newcommand{\ShowAuthor}{\setboolean{BangShowAuthor}{false}}
\newcommand{\HideAuthor}{\setboolean{BangShowAuthor}{true}}

\newcommand{\IfEmptyTF}[3]{%
\if\relax\detokenize{#1}\relax
    #2%
\else
    #3%
\fi
}

\long\def\Algorithm#1#2#3#4#5{
	\subsection{#1}
	
	\ifthenelse{\boolean{BangShowComplexity}}{}{\IfEmptyTF{#3}{}{\textbf{Độ phức tạp:} #3\par}}
	
	\ifthenelse{\boolean{BangShowUsage}}{}{\IfEmptyTF{#2}{}{#2\par}}
	
	% \ifthenelse{\equal{#6}{} \OR \boolean{BangShowAuthor}}{}{\textbf{Author:} #6}
	
	\IfEmptyTF{#5}{}{\IfEmptyTF{#4}{\inputminted[]{cpp}{#5}}{\inputminted[]{#4}{#5}}}
}
